{
  "name": "socwerk-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
